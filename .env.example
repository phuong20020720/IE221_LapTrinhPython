# PostgreSQL (local development only)
POSTGRES_DB=medibook
POSTGRES_USER=medibook
POSTGRES_PASSWORD=medibook_dev
POSTGRES_PORT=5433

# Django
DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5174
BACKEND_PORT=8000

# Email local qua Mailpit
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=mailpit
DJANGO_EMAIL_PORT=1025
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=false
DJANGO_EMAIL_USE_SSL=false
DJANGO_DEFAULT_FROM_EMAIL=Medicare <no-reply@medicare.local>
MAILPIT_WEB_PORT=8025

# Gemini (keep the real key only in local .env or secret manager)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend
FRONTEND_PORT=5174
VITE_API_BASE_URL=http://localhost:8000/api/v1
